clear all
close all
clc

try
    calllib('MoorDyn','LinesClose');       % close MoorDyn
    unloadlibrary MoorDyn;              % unload library (never forget to do this!)
catch
end

%% Setup

load 137_MLER_01.mat


X = [Data.Filt.Surge.TimeHis(1)/1000,Data.Filt.Sway.TimeHis/1000,0,0,0,0];                     % platform position
XD = zeros(6,1);                    % platform velocity
                       
dt = Data.Filt.dt;                          % coupling time step size (time between MoorDyn calls)
T_end=10;
N=round(T_end/dt+1);
Ts = zeros(N,1);                    % time step array
FairTens1 = zeros(N+1,1);           % array for storing fairlead 1 tension time series

FLines_temp = zeros(1,6);           % going to make a pointer so LinesCalc can modify FLines
FLines_p = libpointer('doublePtr',FLines_temp);  % access returned value with FLines_p.value

time=(0:dt:T_end)';

% kin(:,1)=Data.Filt.Surge.TimeHis/1000-Data.Filt.Surge.TimeHis(1)/1000; %dati di input della cinematica (posizione) e deve essere un vettore 6xlength(N)
% kin(:,2)=Data.Filt.Sway.TimeHis/1000-Data.Filt.Sway.TimeHis(1)/1000;
% kin(:,3)=Data.Filt.Heave.TimeHis/1000-Data.Filt.Heave.TimeHis(1)/1000;
kin(:,1)=Data.Filt.Surge.TimeHis/1000; %dati di input della cinematica (posizione) e deve essere un vettore 6xlength(N)
kin(:,2)=Data.Filt.Sway.TimeHis/1000;
kin(:,3)=Data.Filt.Heave.TimeHis/1000;
kin(:,4)=deg2rad(Data.Filt.Roll.TimeHis);
kin(:,5)=deg2rad(Data.Filt.Pitch.TimeHis);
kin(:,6)=deg2rad(Data.Filt.Yaw.TimeHis);
kin_d= diff(kin)./dt;

%% Initialization
loadlibrary('MoorDyn','MoorDyn.h');     % load MoorDyn DLL
calllib('MoorDyn','LinesInit',X,XD)   % initialize MoorDyn 

X = kin(1,:)';   % update position and velocity each time step
XD = kin_d(1,:)';

    
%% Simulation
      
for i=1:N-1        
    calllib('MoorDyn', 'LinesCalc', X, XD, FLines_p, Ts(i), dt);  % some MoorDyn time stepping
    FairTens1(i+1) = calllib('MoorDyn','GetFairTen',1);           % store fairlead 1 tension
    X= kin (i,:)';
     XD = kin_d(i,:)';
    Ts(i+1) = dt*i;                 % store time
end
    
%% Ending
calllib('MoorDyn','LinesClose');       % close MoorDyn
unloadlibrary MoorDyn;              % unload library (never forget to do this!)
